# OpenRouter API key used for cloud models and the summarisation judge. Required for any command
# that calls a cloud model (bench with a config that has cloud models, judge calibrate/score, route
# replay); not needed for offline commands (report --run reference, route --simulate) or local-only
# runs.
OPENROUTER_API_KEY=

# Hard cap in USD for this project's cost ledger. The effective cap is the lower of this value and
# config.yaml's budget_usd; a call that would cross it is refused and the command stops.
LOCAL_ENOUGH_BUDGET_USD=

# Overrides the state directory for the cost ledger and downloads.json (default
# ~/.local/share/local-enough). Useful to isolate runs, for example in tests or CI.
LOCAL_ENOUGH_HOME=
